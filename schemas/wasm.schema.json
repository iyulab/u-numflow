    "UnitDefinitionSpec": {
      "additionalProperties": false,
      "description": "A unit the caller defines: `symbol` = `factor` × `unit` (+ `offset` SI\nunits at its zero, for a scale such as a Fahrenheit degree).",
      "properties": {
        "factor": {
          "default": 1.0,
          "description": "How many `unit` one `symbol` is (default 1, `> 0`).",
          "format": "double",
          "type": "number"
        },
        "offset": {
          "default": 0.0,
          "description": "SI value at the symbol's zero (default 0).",
          "format": "double",
          "type": "number"
        },
        "symbol": {
          "description": "The new symbol, e.g. `cal_IT`.",
          "type": "string"
        },
        "unit": {
          "description": "What it is a multiple of, as a unit expression, e.g. `J`.",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "unit"
      ],
      "type": "object"
    },
    "UnitInfo": {
      "description": "What a unit expression stands for.",
      "properties": {
        "dimension": {
          "description": "The dimension in SI base units, e.g. `kg.m2.s-2` (`1` for a pure number).",
          "type": "string"
        },
        "exponents": {
          "description": "Exponents of m, kg, s, A, K, mol, cd.",
          "items": {
            "format": "int32",
            "type": "integer"
          },
          "maxItems": 7,
          "minItems": 7,
          "type": "array"
        },
        "offset": {
          "description": "SI value of the unit's zero (0 except for scales such as `Cel`).",
          "format": "double",
          "type": "number"
        },
        "scale": {
          "description": "Size of one unit in coherent SI units.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "dimension",
        "exponents",
        "scale",
        "offset"
      ],
      "type": "object"
    },
