          "properties": {
            "kind": {
              "const": "uniform",
              "type": "string"
            },
            "max": {
              "format": "double",
              "type": "number"
            },
            "min": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "min",
            "max"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Triangular on `[min, max]` peaking at `mode`.",
          "properties": {
            "kind": {
              "const": "triangular",
              "type": "string"
            },
            "max": {
              "format": "double",
              "type": "number"
            },
            "min": {
